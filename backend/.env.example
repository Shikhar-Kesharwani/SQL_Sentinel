# Gemini API Key (Required for LLM SQL Generation & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL (Optional: Cloud-native mode. Falls back to SQLite if omitted)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Pinecone Vector Search (Optional: Cloud-native mode. Falls back to local JSON store if omitted)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=sql-sentinel

# Server Port (Default: 8080)
PORT=8080
